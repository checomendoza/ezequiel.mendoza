---
import Header from '../components/Header.astro'
import { getCurrentHost } from '../utilities'
import { useTranslation } from '../i18n/utils'
import type { TypesLang } from '../i18n/i18n.types'
import ProfilePhoto from '../assets/ProfilePhoto.webp'

interface Props {
	title: string
}

const { title } = Astro.props
const { currentLocale } = Astro
const lang = currentLocale as TypesLang
const t = useTranslation(lang)
const siteUrl = getCurrentHost()
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString()
const profileImageUrl = new URL(ProfilePhoto.src, siteUrl).toString()

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Ezequiel Mendoza',
	jobTitle: 'Senior Software Engineer',
	url: `${siteUrl}/`,
	email: 'mailto:ezequielmendoza.dev@gmail.com',
	image: profileImageUrl,
	knowsAbout: [
		'React',
		'Next.js',
		'React Native',
		'TypeScript',
		'Cloud',
		'Artificial Intelligence',
		'AI Engineering',
		'Software Architecture',
	],
	sameAs: [
		'https://github.com/ezequielmendoza-dev',
		'https://www.linkedin.com/in/ezequiel-mendoza/',
		'https://x.com/ezemedev',
	],
}
---

<!doctype html>
<html lang={currentLocale} class='scroll-smooth'>
	<head>
		<!-- Google tag (gtag.js) -->
		<script type='text/partytown' is:inline async src='https://www.googletagmanager.com/gtag/js?id=G-Y160BPR115'></script>
		<script type='text/partytown' is:inline>
			window.dataLayer = window.dataLayer || []
			function gtag() {
				dataLayer.push(arguments)
			}
			gtag('js', new Date())

			gtag('config', 'G-Y160BPR115')
		</script>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width' />
		<meta name='description' content={t('ui.metaDescription')} />
		<meta name='author' content={t('ui.name')} />
		<link rel='icon' type='image/svg+xml' href=`${getCurrentHost()}/favicon.ico` />
		<link rel='canonical' href={pageUrl} />
		<link rel='alternate' hreflang='en' href={`${getCurrentHost()}/`} />
		<link rel='alternate' hreflang='es' href={`${getCurrentHost()}/es`} />
		<link rel='alternate' hreflang='x-default' href={`${getCurrentHost()}/`} />
		<meta property='og:type' content='website' />
		<meta property='og:url' content={pageUrl} />
		<meta property='og:title' content={title} />
		<meta property='og:description' content={t('ui.metaDescription')} />
		<meta property='og:image' content={profileImageUrl} />
		<meta name='twitter:card' content='summary' />
		<meta name='twitter:title' content={title} />
		<meta name='twitter:description' content={t('ui.metaDescription')} />
		<meta name='twitter:image' content={profileImageUrl} />
		<link rel='preconnect' href='https://fonts.googleapis.com' />
		<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
		<link
			href='https://fonts.googleapis.com/css2?family=Reddit+Sans:ital,wght@0,200..900;1,200..900&display=swap'
			rel='stylesheet'
		/>
		<meta name='generator' content={Astro.generator} />
		<title>{title}</title>
		<script type='application/ld+json' is:inline set:html={JSON.stringify(schema)} />
	</head>
	<body class='bg-gray-900 font-redit'>
		<div
			class='mx-auto min-h-screen max-w-screen-xl px-6 py-2 md:px-12 md:py-20 lg:px-32 lg:py-0 lg:flex lg:justify-between lg:gap-10 relative'
		>
			<Header />
			<slot />
		</div>
	</body>
	<script is:inline>
		const sections = document.querySelectorAll('section')
		const menuLinks = document.querySelectorAll('nav ul li a')
		function isSectionVisible(section) {
			const rect = section.getBoundingClientRect()
			return rect.bottom > 0 && rect.top < window.innerHeight + 200
		}

		function updateMenu() {
			let activeSectionIndex = -1
			sections.forEach((section, index) => {
				if (isSectionVisible(section) && activeSectionIndex === -1) {
					activeSectionIndex = index
				}
			})

			menuLinks.forEach((link) => {
				link.classList.remove('text-sky-500')
				link.classList.add('text-gray-400')
			})

			if (activeSectionIndex !== -1) {
				menuLinks[activeSectionIndex].classList.add('text-sky-500')
			}
		}
		window.addEventListener('scroll', updateMenu)
	</script>
</html>
