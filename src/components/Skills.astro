---
import { SkillsData } from '../data'
import type { TypesLang } from '../i18n/i18n.types'
import { useTranslation } from '../i18n/utils'

const { currentLocale } = Astro
const lang = currentLocale as TypesLang
const t = useTranslation(lang)
---

<section id='skills' class='mt-10'>
	<div class='sticky top-0 backdrop-blur-lg z-20 -mx-6 py-2 px-6 lg:relative'>
		<h2 class='font-semibold text-xl text-gray-100'>{t('ui.skillsTitle')}</h2>
		<div class='w-11 h-1 bg-sky-600 my-1 rounded-lg'></div>
		<p class='text-sm font-light text-gray-400 pb-2'>{t('ui.skillsSubTitle')}</p>
	</div>

	<div class='mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3'>
		{
			SkillsData.map((group) => (
				<div class='rounded-xl border border-gray-800 bg-gray-800/40 p-5'>
					<h3 class='text-sm font-semibold uppercase tracking-wider text-sky-400'>
						{group.title}
					</h3>
					<div class='mt-3 flex flex-wrap gap-2'>
						{
							group.skills.map((skill) => (
								<span
									class='rounded-full bg-gray-700/60 px-3 py-1 text-xs font-medium text-gray-300'
								>
									{skill}
								</span>
							))
						}
					</div>
				</div>
			))
		}
	</div>
</section>
