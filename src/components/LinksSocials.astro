---
import type { TypesLang } from '../i18n/i18n.types'
import { useTranslation } from '../i18n/utils'

const { currentLocale } = Astro
const lang = currentLocale as TypesLang
const t = useTranslation(lang)
---

<ul class='flex flex-row space-x-6 pt-5 justify-center'>
	<li>
		<a
			href='https://www.linkedin.com/in/ezequiel-mendoza/'
			target='_blank'
			class='hover:text-slate-400'
			aria-label=`LinkedIn ${t('ui.name')}`
		>
			<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='currentColor' class='h-6 w-6' aria-hidden='true'
				><path
					d='M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19a.66.66 0 000 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z'
				></path></svg
			>
		</a>
	</li>
	<li>
		<a
			href='https://github.com/ezequielmendoza-dev'
			target='_blank'
			aria-label=`GitHub ${t('ui.name')}`
			class='hover:text-slate-400'
		>
			<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='currentColor' class='h-6 w-6' aria-hidden='true'
				><path
					d='M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z'
				></path></svg
			>
		</a>
	</li>
	<li>
		<a
			href='https://x.com/ezemedev'
			target='_blank'
			aria-label=`X ${t('ui.name')}`
			class='hover:text-slate-400'
		>
			<svg
				xmlns='http://www.w3.org/2000/svg'
				viewBox='0 0 150 150'
				fill='currentColor'
				class='h-6 w-6'
				aria-hidden='true'
			>
				<path d='M75.916 54.2 122.542 0h-11.05L71.008 47.06 38.672 0H1.376l48.898 71.164L1.376 128h11.05L55.18 78.303 89.328 128h37.296L75.913 54.2ZM60.782 71.79l-4.955-7.086-39.42-56.386h16.972L65.19 53.824l4.954 7.086 41.353 59.15h-16.97L60.782 71.793Z'></path>
			</svg>
		</a>
	</li>
	<li>
		<a
			href='mailto:ezequielmendoza.dev@gmail.com'
			aria-label=`Email ${t('ui.name')}`
			class='hover:text-slate-400'
		>
			<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='h-6 w-6' aria-hidden='true'
				><rect width='20' height='16' x='2' y='4' rx='2'></rect><path
					d='m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7'
				></path></svg
			>
		</a>
	</li>
</ul>
