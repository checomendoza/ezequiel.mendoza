---
import { ExperiencesData } from '../data'
import type { TypesLang } from '../i18n/i18n.types'
import { useTranslation } from '../i18n/utils'

const { currentLocale } = Astro
const lang = currentLocale as TypesLang
const t = useTranslation(lang)
---

<section id='experience' class='mt-10'>
	<div class='sticky top-0 backdrop-blur-lg z-20 -mx-6 py-2 px-6 lg:relative'>
		<h2 class='font-semibold text-xl text-gray-100'>{t('ui.experienceTitle')}</h2>
		<div class='w-11 h-1 bg-sky-600 my-1 rounded-lg'></div>
		<p class='text-sm font-light text-gray-400 pb-2'>{t('ui.experienceSubTitle')}</p>
	</div>

	<div class='relative mt-6 border-s border-gray-800 ps-6 space-y-10'>
		{
			ExperiencesData[lang]?.map((item) => (
				<div class='relative'>
					<span
						class='absolute -start-[29px] top-1 h-[9px] w-[9px] rounded-full bg-sky-600 ring-4 ring-gray-900'
					></span>
					<div class='flex flex-wrap items-baseline gap-x-3 gap-y-1'>
						<h3 class='font-semibold text-gray-200'>{item.role}</h3>
						<span class='text-sm text-sky-300 font-medium'>{item.company}</span>
						<span class='text-xs text-gray-500'>{item.period}</span>
						<span class='text-xs text-gray-600'>{item.location}</span>
					</div>
					<ul class='mt-3 space-y-2'>
						{
							item.highlights.map((highlight) => (
								<li class='flex gap-2 text-sm text-gray-400 font-light leading-relaxed'>
									<svg
										viewBox='0 0 24 24'
										fill='none'
										stroke='currentColor'
										stroke-width='2'
										stroke-linecap='round'
										stroke-linejoin='round'
										class='mt-0.5 h-3.5 w-3.5 shrink-0 text-sky-500'
										aria-hidden='true'
									>
										<path d='M20 6 9 17l-5-5' />
									</svg>
									<span>{highlight}</span>
								</li>
							))
						}
					</ul>
					<div class='mt-3 flex flex-wrap gap-2'>
						{
							item.technologies.map((tech) => (
								<span
									class='rounded-full bg-gray-700/60 px-3 py-1 text-xs font-medium text-gray-300'
								>
									{tech}
								</span>
							))
						}
					</div>
				</div>
			))
		}
	</div>
</section>
