---
import type { TypesLang } from '../i18n/i18n.types'
import { useTranslation } from '../i18n/utils'
import LinksSocials from './LinksSocials.astro'
import SwitchLanguage from './SwitchLanguage.astro'
import { getCurrentHost } from '../utilities'

const { currentLocale } = Astro
const lang = currentLocale as TypesLang
const t = useTranslation(lang)
---

<aside class='lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-1/3 lg:flex-col lg:py-24 space-y-2'>
	<SwitchLanguage />
	<div
		class='flex justify-center flex-col text-gray-200 bg-gray-800 px-5 pt-2 pb-5 rounded-lg divide-y divide-gray-700'
	>
		<div class='flex flex-col items-center gap-3 py-5'>
			<img
				src=`${getCurrentHost()}/images/webp/ProfilePhoto.webp`
				class='bg-gray-400 rounded-full w-40 ring-2 ring-sky-500/40'
				width='160'
				height='160'
				alt=`${t('ui.name')}`
			/>
			<div class='items-center flex flex-col text-center gap-1'>
				<h1 class='text-3xl font-bold'>{t('ui.name')}</h1>
				<h2 class='text-lg text-sky-300 font-semibold'>{t('ui.title')}</h2>
				<p class='text-sm text-gray-400 font-light mt-2 leading-relaxed'>
					{t('ui.tagline')}
				</p>
			</div>
			<span
				class='inline-flex items-center gap-2 rounded-full bg-emerald-400/10 px-3 py-1 text-xs font-medium text-emerald-300 ring-1 ring-inset ring-emerald-400/20'
			>
				<span class='relative flex h-2 w-2'>
					<span
						class='absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75'
					></span>
					<span class='relative inline-flex h-2 w-2 rounded-full bg-emerald-400'></span>
				</span>
				{t('ui.availability')}
			</span>
		</div>

		<div class='flex flex-wrap items-center justify-center gap-2 py-4'>
			<a
				href='mailto:ezequielmendoza.dev@gmail.com'
				class='rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-500 transition-colors'
			>
				{t('ui.ctaContact')}
			</a>
			<a
				href='https://www.linkedin.com/in/ezequiel-mendoza/'
				target='_blank'
				rel='noopener noreferrer'
				class='rounded-lg bg-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 hover:bg-gray-600 transition-colors'
			>
				LinkedIn
			</a>
			<a
				href='https://github.com/ezequielmendoza-dev'
				target='_blank'
				rel='noopener noreferrer'
				class='rounded-lg bg-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 hover:bg-gray-600 transition-colors'
			>
				GitHub
			</a>
		</div>

		<nav class='hidden lg:flex py-6 text-left'>
			<ul class='flex flex-col gap-1 w-full'>
				<li>
					<a
						href='#about'
						class='text-sky-500 font-medium py-2 px-3 rounded-lg w-full hover:text-sky-300/80 transition-colors'
					>
						{t('ui.aboutTitle')}
					</a>
				</li>
				<li>
					<a
						href='#experience'
						class='text-gray-400 font-medium py-2 px-3 rounded-lg w-full hover:text-sky-300/80 transition-colors'
					>
						{t('ui.experienceTitle')}
					</a>
				</li>
				<li>
					<a
						href='#projects'
						class='text-gray-400 font-medium py-2 px-3 rounded-lg w-full hover:text-sky-300/80 transition-colors'
					>
						{t('ui.projectsTitle')}
					</a>
				</li>
				<li>
					<a
						href='#skills'
						class='text-gray-400 font-medium py-2 px-3 rounded-lg w-full hover:text-sky-300/80 transition-colors'
					>
						{t('ui.skillsTitle')}
					</a>
				</li>
				<li>
					<a
						href='#focus'
						class='text-gray-400 font-medium py-2 px-3 rounded-lg w-full hover:text-sky-300/80 transition-colors'
					>
						{t('ui.focusTitle')}
					</a>
				</li>
			</ul>
		</nav>

		<LinksSocials />
	</div>
</aside>
